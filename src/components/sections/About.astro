---
interface ServiceItem {
  name: string;
  description: string;
}

interface Props {
  sectionId: string;
  heading: string;
  indexLabel: string;
  photo: {
    image: string;
    imageAlt: string;
    sticker: string;
  };
  bio: {
    heading: string;
    paragraphs: string[];
    stackTitle: string;
    stackTags: string[];
  };
  services: {
    heading: string;
    items: ServiceItem[];
  };
}

const { sectionId, heading, indexLabel, photo, bio, services } = Astro.props;
---

<div class="section-header" id={sectionId}>
  <h2 class="section-title">{heading}</h2>
  <span class="section-index">{indexLabel}</span>
</div>

<section class="bento-grid">
  <div class="bento-card about-photo-card">
    <img
      class="portrait-img"
      src={photo.image}
      alt={photo.imageAlt}
      loading="lazy"
    />
    <span class="hello-sticker">{photo.sticker}</span>
  </div>

  <div class="bento-card about-bio-card">
    <div class="bio-text">
      <h3 class="card-heading">{bio.heading}</h3>
      {bio.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div>
      <div class="stack-block-title">{bio.stackTitle}</div>
      <div class="tags-list">
        {bio.stackTags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </div>

  <div class="bento-card about-services-card">
    <div>
      <h3 class="services-heading">{services.heading}</h3>
      <ul class="services-list">
        {
          services.items.map((service) => (
            <li>
              <div class="service-name">{service.name}</div>
              <div class="service-desc">{service.description}</div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about-photo-card {
    grid-column: span 4;
    padding: 0;
    min-height: 460px;
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.05);
    transition:
      filter 0.5s var(--transition-smooth),
      transform 0.5s var(--transition-smooth);
  }

  .about-photo-card:hover .portrait-img {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.02);
  }

  .hello-sticker {
    position: absolute;
    bottom: 24px;
    right: 24px;
    background: var(--accent-terracotta);
    color: var(--bg-canvas);
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    transform: rotate(-6deg) scale(0.8);
    opacity: 0;
    transition: all 0.35s var(--transition-smooth);
    box-shadow: var(--shadow-sticker);
  }

  .about-photo-card:hover .hello-sticker {
    opacity: 1;
    transform: rotate(-6deg) scale(1);
  }

  .about-bio-card {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .card-heading {
    font-size: var(--text-xl);
    font-weight: 500;
    margin-bottom: 16px;
  }

  .bio-text p {
    margin-bottom: 16px;
    font-size: var(--text-base);
    color: var(--text-primary);
  }

  .bio-text p:last-child {
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .stack-block-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .about-services-card {
    grid-column: span 4;
    background-color: var(--bg-dark);
    color: var(--bg-canvas);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .services-heading {
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .services-list {
    list-style: none;
    margin-top: 20px;
  }

  .services-list li {
    padding: 16px 0;
    border-bottom: 1px solid var(--border-on-dark);
  }

  .services-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .service-name {
    font-weight: 600;
    font-size: var(--text-md);
    margin-bottom: 4px;
    color: var(--bg-canvas);
  }

  .service-desc {
    font-size: 0.875rem;
    color: var(--text-muted-on-dark);
  }

  @media (max-width: 1024px) {
    .about-photo-card,
    .about-bio-card {
      grid-column: span 6;
    }
    .about-services-card {
      grid-column: span 12;
    }
  }

  @media (max-width: 767px) {
    .about-photo-card,
    .about-bio-card,
    .about-services-card {
      grid-column: span 12;
    }
  }
</style>
